{
  "name": "teacher-alma-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "demo:lessons:reset": "node --import tsx scripts/seed-courses-demo.ts --reset --lessons",
    "demo:check": "node --import tsx scripts/seed-courses-demo.ts --check",
    "demo:gamification:reset": "node --import tsx scripts/run-gamification-demo.ts reset",
    "demo:gamification:reset-streak": "node --import tsx scripts/run-gamification-demo.ts reset-streak",
    "demo:gamification:reset-daily-goal": "node --import tsx scripts/run-gamification-demo.ts reset-daily-goal",
    "demo:gamification:reset-inventory": "node --import tsx scripts/run-gamification-demo.ts reset-inventory",
    "demo:gamification:set-coins": "node --import tsx scripts/run-gamification-demo.ts set-coins",
    "seed:gamification": "node --import tsx scripts/seed-gamification.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
